# NutriAI backend — exemplu fără credentiale reale. Nu copia valori secrete în git.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Supabase (toate obligatorii; service role este secret backend-only)
SUPABASE_URL=https://proiectul-tau.supabase.co
SUPABASE_ANON_KEY=de_completat
SUPABASE_SERVICE_ROLE_KEY=de_completat

# CORS: listă explicită de origini HTTPS, fără wildcard în producție
CORS_ORIGINS=https://domeniul-tau-public.ro

# AI — Gemini este obligatoriu; ceilalți provideri sunt fallback opțional
GEMINI_API_KEY=de_completat
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_TEXT_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b
GROQ_VISION_MODELS=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_MAX_CONCURENTA=4
AI_MAX_COADA=12
AI_PHOTO_TRIGGER_CONCURRENCY=8
GEMINI_PHOTO_ATTEMPTS_PER_RUN=2
FLOW_CREDITS_DAILY_LIMIT=3
FLOW_REWARDED_DAILY_LIMIT=5
ADMOB_REWARDED_AD_UNIT_ID=3566028223
ADMOB_REWARDED_REWARD_AMOUNT=1
ADMOB_REWARDED_REWARD_ITEM=Flow Credit
PREMIUM_PHOTO_DAILY_FAIR_USE=50
AI_CHAT_GLOBAL_CONCURRENCY=12
AI_MAX_APELURI_PER_REQUEST=8

# Redis TLS partajat pentru rate-limit, cote, idempotency și cooldown
REDIS_URL=rediss://utilizator:parola@host:6379
INSTANTE_ASTEPTATE=1


# Clerk Production (secrete backend-only)
CLERK_SECRET_KEY=sk_live_de_completat
CLERK_WEBHOOK_SIGNING_SECRET=whsec_de_completat

# Google Play Billing direct (autoritate backend-only)
GOOGLE_PLAY_PACKAGE_NAME=com.totsrl.getflo
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_IDS=premium_monthly,premium_annual
GOOGLE_PLAY_CREDIT_PRODUCT_IDS=getflow_credits_10,getflow_credits_30
# Cale locală către credentialele ADC ale contului de serviciu; nu comite fișierul JSON.
GOOGLE_APPLICATION_CREDENTIALS=C:\cale-secreta\google-play-service-account.json
GOOGLE_PLAY_PUBSUB_AUDIENCE=https://api.domeniul-tau-public.ro/api/v1/webhooks/google-play
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=play-rtdn@proiectul-tau.iam.gserviceaccount.com
# Lansare controlată: `observe` după conectarea proiectului Cloud și deploy;
# `enforce` numai după validarea nativă pe build instalat din Google Play.
PLAY_INTEGRITY_MODE=observe

# ImageKit (private key este secretă; public key nu este secretă)
IMAGEKIT_PUBLIC_KEY=de_completat
IMAGEKIT_PRIVATE_KEY=de_completat
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/identificator

# Observabilitate (DSN-ul este configurare publicabilă; saltul este secret)
SENTRY_DSN=https://cheie-publica@organizatie.ingest.sentry.io/id-proiect
SENTRY_PII_SALT=secret-aleator-de-minimum-32-caractere

# Trigger.dev Production (secret backend-only; trebuie să înceapă cu tr_prod_)
TRIGGER_SECRET_KEY=tr_prod_de_completat

# Workeri de recuperare. GDPR trebuie activ în producție; reconcilierea creditelor
# este activă implicit și poate fi oprită doar explicit în dezvoltare/test.
GDPR_WORKER_ACTIV=1
CREDIT_RECONCILE_ACTIV=1

# Cache și keep-alive
BARCODE_CACHE_TTL_ZILE=30
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MINUTES=14
# RENDER_EXTERNAL_URL este injectat automat de Render, dacă serviciul rulează acolo.

# Numai pentru testele RLS/PostgREST locale sau CI; nu sunt variabile runtime.
INTEGRATION_DB_URL=
INTEGRATION_SUPABASE_URL=
INTEGRATION_ANON_KEY=
INTEGRATION_JWT_SECRET=

# Numai pentru scripts/create-admin.js, nu pentru procesul web.
ADMIN_PASSWORD=
