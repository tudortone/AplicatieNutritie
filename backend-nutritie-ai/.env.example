# Exemplu de configurare variabile de mediu pentru serverul NutriAI Backend
PORT=[REDACTED]
HOST=[REDACTED]

# Chei API Google Gemini (opțional se pot seta chei de rotație GEMINI_API_KEY_2, _3, _4)
GEMINI_API_KEY=[REDACTED]
# Opțional: Modelul Gemini preferat (ex: gemini-2.5-flash). Dacă lipsește sau e greșit, cascada folosește modelele stabile de fallback.
GEMINI_MODEL=[REDACTED]

# Cheie API Groq (pentru text/chat rapid)
GROQ_API_KEY=[REDACTED]
# Modele text Groq folosite in ordine (separat prin virgula). Implicit: openai/gpt-oss-120b,qwen/qwen3.6-27b
GROQ_TEXT_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b

# Cheie API OpenAI (pentru fallback opțional)
OPENAI_API_KEY=[REDACTED]

# Supabase (pentru validare token JWT și acces la baza de date)
SUPABASE_URL=[REDACTED]
SUPABASE_ANON_KEY=[REDACTED]
SUPABASE_SERVICE_ROLE_KEY=[REDACTED]

# Setări CORS (domenii permise sau * pentru dev)
CORS_ORIGINS=[REDACTED]
# Cheie API OpenRouter (fallback vision opțional)
OPENROUTER_API_KEY=

# Modele vision Groq folosite în cascadă (listă separată prin virgulă).
# Implicit: meta-llama/llama-4-scout-17b-16e-instruct,meta-llama/llama-4-maverick-17b-128e-instruct
GROQ_VISION_MODELS=

# Keep-alive (anti-sleep pe Render/Railway). URL-ul primește automat sufixul /health.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MINUTES=10

# Mediu de rulare (development activează loguri suplimentare)
NODE_ENV=production

# --- Identitate Clerk (opțional; JWT template acceptat de Supabase) ---
# Cheia secretă Clerk pentru verificarea token-urilor Clerk (C4).
# Pentru ca RLS să se aplice și pe utilizatorii Clerk, configurează în dashboard-ul
# Clerk un "Supabase JWT template" (iss/aud/sub = utilizatorul Supabase, semnat cu
# secretul JWT al proiectului Supabase). Fără template, provider='clerk' => RLS inactiv.
CLERK_SECRET_KEY=
# Cheie de semnare a webhook-urilor Clerk (Webhooks → Signing secret). Obligatorie
# în producție: fără ea, config/env.js oprește boot-ul (fail-fast).
CLERK_WEBHOOK_SECRET=

# --- Monitorizare erori (Sentry) ---
# DSN-ul proiectului Sentry pentru backend. Dacă lipsește, raportarea e dezactivată.
SENTRY_DSN=

# --- Trigger.dev (analiză AI în fundal) ---
# Cheie de semnare pentru apeluri Trigger.dev. Dacă lipsește, /api/trigger-analiza-mancare
# răspunde cu 503 (disabled).
TRIGGER_SECRET_KEY=

# --- ImageKit (stocare imagini, necesar pentru autentificare upload) ---
# Toate trei sunt obligatorii pentru ca /api/imagekit-auth să nu răspundă 503.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Concurrență AI (protecție heap la vârf de trafic) ---
# Max cereri AI simultane pe instanță și max coadă pentru cele în exces.
AI_MAX_CONCURENTA=4
AI_MAX_COADA=12

# --- Store partajat de rate-limit / cooldown AI (B-10) ---
# Pe mai multe instanțe, limitele și cooldown-urile trebuie să fie partajate.
# Dacă lipsește, se folosește MemoryStore per-proces (limitele se înmulțesc cu
# numărul de instanțe — doar pentru dev).
REDIS_URL=

# --- RevenueCat (validare premium server-side, B-09) ---
# Cheie SECRETĂ RevenueCat (Nu v3 / secret), nu cheia publică din SDK.
# Fără ea, /api/user/premium-status răspunde 503 (disabled).
REVENUECAT_SECRET_API_KEY=
# Cheie de semnare a webhook-urilor RevenueCat (Dashboard → App → Webhooks → Authorization).
# Obligatorie în producție: fără ea, config/env.js oprește boot-ul (fail-fast).
REVENUECAT_WEBHOOK_SECRET=
