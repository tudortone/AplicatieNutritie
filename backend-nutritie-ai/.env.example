# Exemplu de configurare variabile de mediu pentru serverul NutriAI Backend
PORT=[REDACTED]
HOST=[REDACTED]

# Chei API Google Gemini (opțional se pot seta chei de rotație GEMINI_API_KEY_2, _3, _4)
GEMINI_API_KEY=[REDACTED]
# Opțional: Modelul Gemini preferat (ex: gemini-2.5-flash). Dacă lipsește sau e greșit, cascada folosește modelele stabile de fallback.
GEMINI_MODEL=[REDACTED]

# Cheie API Groq (pentru text/chat rapid)
GROQ_API_KEY=[REDACTED]

# Cheie API OpenAI (pentru fallback opțional)
OPENAI_API_KEY=[REDACTED]

# Supabase (pentru validare token JWT și acces la baza de date)
SUPABASE_URL=[REDACTED]
SUPABASE_ANON_KEY=[REDACTED]
SUPABASE_SERVICE_ROLE_KEY=[REDACTED]

# Setări CORS (domenii permise sau * pentru dev)
CORS_ORIGINS=[REDACTED]
# Cheie API OpenRouter (fallback vision opțional)
OPENROUTER_API_KEY=

# Modele vision Groq folosite în cascadă (listă separată prin virgulă).
# Implicit: meta-llama/llama-4-scout-17b-16e-instruct,meta-llama/llama-4-maverick-17b-128e-instruct
GROQ_VISION_MODELS=

# Keep-alive (anti-sleep pe Render/Railway). URL-ul primește automat sufixul /health.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MINUTES=10

# Mediu de rulare (development activează loguri suplimentare)
NODE_ENV=production
