# Exemplu de configurare variabile de mediu pentru frontend NutriAI
# Copiază acest fișier în .env și completează cu valorile tale reale.
# NOTĂ: Fișierul .env este ignorat de git (vezi .gitignore) — nu commita chei reale.

# Poarta EAS production refuză orice altă valoare.
EXPO_PUBLIC_APP_ENV=production

# URL backend AI (Render/local)
EXPO_PUBLIC_API_URL=https://nutritie-backend-ai.onrender.com

# Numărul numeric al proiectului Google Cloud conectat la Play Integrity.
# Nu este secret; lăsați gol până când Play Console confirmă asocierea.
EXPO_PUBLIC_PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=435128681048

# Supabase — cheia "anon"/"publishable" (sigură de inclus în client, RLS activ)
EXPO_PUBLIC_SUPABASE_URL=https://proiectul-tau.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cheia_ta_anon_sau_publishable

# ImageKit — cheia publică (folosită pentru upload-ul imaginilor la jurnal; semnarea
# reală o face backend-ul via /api/imagekit-auth). Dacă lipsește, upload-ul e dezactivat.
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=cheia_ta_publica_imagekit

# Sentry — DSN public al clientului. Dacă lipsește, Sentry client nu se inițializează.
EXPO_PUBLIC_SENTRY_DSN=https://cheie-publica@organizatie.ingest.sentry.io/id-proiect

# Billing nu are chei publice în client. Catalogul și entitlement-ul vin din backend,
# iar checkout-ul Android este realizat direct prin Google Play Billing.
# Documente legale — URL-uri HTTPS publice ale Termenilor și Condițiilor și
# al Politicii de Confidențialitate (deschise extern prin Linking).
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://domeniul-tau-public.ro/termeni
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://domeniul-tau-public.ro/confidentialitate

# Reclame (AdMob) — Mod canonic unic (autoritate exclusivă): 'disabled' | 'test' | 'real'
# În dezvoltare/local: sunt permise 'disabled' și 'test' (și 'real' cu ID-uri reale valide).
# În producție (EAS production / release): este permis EXCLUSIV 'real', necesitând App ID și Unit ID reale valide (fail-closed; 'disabled' și 'test' sunt strict interzise în producție).
EXPO_PUBLIC_ADS_MODE=real
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~ZZZZZZZZZZ
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID_ID=ca-app-pub-XXXXXXXXXXXXXXXX/AAAAAAAAAA
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS_ID=ca-app-pub-XXXXXXXXXXXXXXXX/BBBBBBBBBB
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_ID=ca-app-pub-XXXXXXXXXXXXXXXX/CCCCCCCCCC
EXPO_PUBLIC_ADMOB_REWARDED_IOS_ID=ca-app-pub-XXXXXXXXXXXXXXXX/DDDDDDDDDD
# Opționale — au valori implicite sensibile (3 analize / 45s) dacă lipsesc.
EXPO_PUBLIC_AD_EVERY_N_ANALYSES=3
EXPO_PUBLIC_AD_MIN_INTERVAL_SECONDS=45
