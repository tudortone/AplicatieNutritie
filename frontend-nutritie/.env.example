# Exemplu de configurare variabile de mediu pentru frontend NutriAI
# Copiază acest fișier în .env și completează cu valorile tale reale.
# NOTĂ: Fișierul .env este ignorat de git (vezi .gitignore) — nu commita chei reale.

# URL backend AI (Render/local)
EXPO_PUBLIC_API_URL=https://nutritie-backend-ai.onrender.com

# Supabase — cheia "anon"/"publishable" (sigură de inclus în client, RLS activ)
EXPO_PUBLIC_SUPABASE_URL=https://proiectul-tau.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cheia_ta_anon_sau_publishable
