{
  "expo": {
    "name": "GetFlow",
    "slug": "nutriai",
    "owner": "totsrl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutriai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.totsrl.getflow",
      "buildNumber": "1",
      "infoPlist": {
        "NSMotionUsageDescription": "GetFlow utilizează senzorul de mișcare pentru a contoriza pașii zilnici și caloriile arse.",
        "NSCameraUsageDescription": "GetFlow are nevoie de acces la cameră pentru a analiza mâncarea din farfurie.",
        "NSPhotoLibraryUsageDescription": "GetFlow accesează galeria pentru a selecta poze cu mâncare."
      }
    },
    "android": {
      "package": "com.totsrl.getflo",
      "versionCode": 14,
      "icon": "./assets/images/icon.png",
      "allowBackup": false,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#090C0E",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#090C0E",
          "dark": {
            "backgroundColor": "#090C0E"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "GetFlow are nevoie de acces la cameră pentru a analiza mâncarea din farfurie.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GetFlow are nevoie de acces la galerie pentru a selecta poze cu mâncare.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "GetFlow utilizează senzorul de mișcare pentru a număra pașii zilnici."
        }
      ],
      "expo-secure-store",
      "expo-iap",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18cf8908-194b-4386-a700-22dea945da47"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/18cf8908-194b-4386-a700-22dea945da47"
    }
  }
}
