{
  "expo": {
    "name": "NutriAI",
    "slug": "nutriai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutriai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutriai.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMotionUsageDescription": "NutriAI utilizează senzorul de mișcare pentru a contoriza pașii zilnici și caloriile arse.",
        "NSCameraUsageDescription": "NutriAI are nevoie de acces la cameră pentru a analiza mâncarea din farfurie.",
        "NSPhotoLibraryUsageDescription": "NutriAI accesează galeria pentru a selecta poze cu mâncare."
      }
    },
    "android": {
      "package": "com.nutriai.app",
      "versionCode": 1,
      "icon": "./assets/images/icon.png",
      "allowBackup": false,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#090C0E",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#090C0E",
          "dark": {
            "backgroundColor": "#090C0E"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "NutriAI are nevoie de acces la cameră pentru a analiza mâncarea din farfurie."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriAI are nevoie de acces la galerie pentru a selecta poze cu mâncare."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "NutriAI utilizează senzorul de mișcare pentru a număra pașii zilnici."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18cf8908-194b-4386-a700-22dea945da47"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/18cf8908-194b-4386-a700-22dea945da47"
    }
  }
}
